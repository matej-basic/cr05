# rsyslog receiver for the lab C1 off-host forwarding step.
# Accepts forwarded logs on 514 (TCP and UDP) and files them per source host.
module(load="imudp")
input(type="imudp" port="514")
module(load="imtcp")
input(type="imtcp" port="514")

template(name="PerHostRemote" type="string"
         string="{{ remote_log_dir }}/%HOSTNAME%.log")

if ($fromhost-ip != "127.0.0.1") then {
    action(type="omfile" dynaFile="PerHostRemote")
}
